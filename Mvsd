-- [[ Sparx x Moneyhub - Fixed Auto Farm ]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- PASTE YOUR RAW SCRIPT URL HERE FOR TELEPORT PERSISTENCE
local SCRIPT_RAW_URL = "https://raw.githubusercontent.com/sparxtools/Mvsd/refs/heads/main/Mvsd"

local queue_on_teleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)

local function ArmTeleportQueue()
    if queue_on_teleport and (getgenv().autoShoot or getgenv().autoEquip) then
        queue_on_teleport(string.format([[
            getgenv().autoShoot = true
            getgenv().autoEquip = true
            repeat task.wait() until game:IsLoaded()
            task.wait(2)
            loadstring(game:HttpGet("%s"))()
        ]], SCRIPT_RAW_URL))
    end
end

getgenv().autoShoot = getgenv().autoShoot or false
getgenv().autoEquip = getgenv().autoEquip or false
getgenv().aimConfig = { 
    MAX_DISTANCE = 500,
    PREDRATE = 0.135
}

local autoShootConnection = nil
local lastFireTime = 0
local lastEquipTime = 0
local lastQueueTime = 0
local matchStartTime = 0
local wasInMatch = false

local FIRE_RATE_COOLDOWN = 0.05
local EQUIP_COOLDOWN = 0.3 
local QUEUE_COOLDOWN = 6.0 
local MATCH_LOAD_DELAY = 4.0 

-- Exact 1v1 Server Detector: 2 players means in-match server
local function IsInMatch()
    local allPlayers = Players:GetPlayers()
    return #allPlayers == 2
end

local function getNearestTarget()
    local LocalPlayer = Players.LocalPlayer
    local myChar = LocalPlayer and LocalPlayer.Character 
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart") 
    if not myRoot then return nil, nil end
    
    local nearestPlayer, minDist = nil, math.huge
    local targetVelocity = Vector3.new(0, 0, 0)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead and player.Character.Parent == Workspace then
                if not player.Team or not LocalPlayer.Team or player.Team ~= LocalPlayer.Team then
                    local enemyRoot = player.Character.HumanoidRootPart 
                    local dist = (enemyRoot.Position - myRoot.Position).Magnitude
                    
                    local velocity = enemyRoot.AssemblyLinearVelocity
                    if dist < minDist and dist <= getgenv().aimConfig.MAX_DISTANCE and velocity.Y > -100 then 
                        minDist = dist
                        nearestPlayer = enemyRoot
                        targetVelocity = velocity
                    end
                end
            end
        end
    end 
    
    if nearestPlayer then
        local predictedPos = nearestPlayer.Position + (targetVelocity * getgenv().aimConfig.PREDRATE)
        return nearestPlayer, predictedPos
    end
    return nil, nil
end

getgenv().MoneyhubSharedCore = {
    getNearestTarget = getNearestTarget,
    getConn = function() return autoShootConnection end,
    setConn = function(v) autoShootConnection = v end
}

local Shared = getgenv().MoneyhubSharedCore

local function JoinMatchmaking()
    pcall(function()
        local globalMatchmaking = ReplicatedStorage:FindFirstChild("GlobalMatchmaking")
        local remotes = globalMatchmaking and globalMatchmaking:FindFirstChild("Remotes")
        local joinQueue = remotes and remotes:FindFirstChild("JoinQueue")
        
        if joinQueue then
            ArmTeleportQueue()
            joinQueue:InvokeServer("Solo")
        end
    end)
end

local function StartAutoShoot()
    local currentConn = Shared.getConn()
    if currentConn then currentConn:Disconnect() end
    
    local newConn = RunService.Heartbeat:Connect(function()
        local LocalPlayer = Players.LocalPlayer
        if not LocalPlayer then return end

        if getgenv().autoShoot or getgenv().autoEquip then
            local inMatchNow = IsInMatch()
            
            if inMatchNow and not wasInMatch then
                matchStartTime = os.clock()
            end
            wasInMatch = inMatchNow

            if not inMatchNow then
                -- LOBBY STATE: Re-queue & save state across rounds
                local currentTime = os.clock()
                if (currentTime - lastQueueTime) >= QUEUE_COOLDOWN then
                    lastQueueTime = currentTime
                    ArmTeleportQueue()
                    task.spawn(JoinMatchmaking)
                end
            else
                -- MATCH STATE: Respect loading delay
                if (os.clock() - matchStartTime) < MATCH_LOAD_DELAY then
                    return 
                end

                local myChar = LocalPlayer.Character
                if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
                
                local humanoid = myChar:FindFirstChildOfClass("Humanoid")
                if not humanoid or humanoid.Health <= 0 then return end

                local currentTime = os.clock()
                
                -- Auto Equip
                local hasTool = myChar:FindFirstChildOfClass("Tool") or myChar:FindFirstChild("Gun_Equip")
                if not hasTool and getgenv().autoEquip then
                    if (currentTime - lastEquipTime) >= EQUIP_COOLDOWN then
                        lastEquipTime = currentTime
                        pcall(function()
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Two, false, game)
                            task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Two, false, game)
                        end)
                    end
                    return 
                end
                
                if not getgenv().autoShoot then return end
                if (currentTime - lastFireTime) < FIRE_RATE_COOLDOWN then return end
                
                local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
                local ShootRemote = remotesFolder and remotesFolder:FindFirstChild("ShootGun")
                if not ShootRemote then return end
                
                local gunModel = myChar:FindFirstChild("Gun_Equip") or myChar:FindFirstChildOfClass("Tool")
                local muzzle = gunModel and gunModel:FindFirstChild("Muzzle", true)
                if not muzzle then return end
                
                local targetInstance, predictedPosition = Shared.getNearestTarget()
                if targetInstance and predictedPosition then
                    lastFireTime = currentTime 
                    
                    -- Sparx 5x Burst Fire Logic
                    task.spawn(function()
                        for i = 1, 5 do
                            pcall(function()
                                ShootRemote:FireServer(muzzle.WorldPosition, predictedPosition, targetInstance, predictedPosition)
                            end)
                            task.wait(0.01)
                        end
                    end)
                end
            end
        end
    end)
    
    Shared.setConn(newConn)
end

-- Rayfield UI Setup
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))() 

local window = Rayfield:CreateWindow({ 
    name = "MVSD", 
    subtitle = "By Sparx / luhscripter", 
}) 

local tab = window:CreateTab({ 
    name = "Main"
}) 

tab:CreateToggle({
    name = "Auto Kill All (Gun)",
    currentValue = getgenv().autoShoot,
    callback = function(value)
        getgenv().autoShoot = value
        if value then 
            StartAutoShoot() 
            ArmTeleportQueue()
        elseif not getgenv().autoEquip then
            local c = Shared.getConn() 
            if c then c:Disconnect() end 
        end
    end
})

tab:CreateToggle({
    name = "Auto Equip Gun",
    currentValue = getgenv().autoEquip,
    callback = function(value)
        getgenv().autoEquip = value
        if value then
            StartAutoShoot()
            ArmTeleportQueue()
        elseif not getgenv().autoShoot then
            local c = Shared.getConn()
            if c then c:Disconnect() end
        end
    end
})

-- Auto Start if enabled on teleport
if getgenv().autoShoot or getgenv().autoEquip then
    StartAutoShoot()
end
