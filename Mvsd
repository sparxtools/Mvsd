-- Target Logic
local function getNearestTarget()
    local LocalPlayer = Players.LocalPlayer
    if not LocalPlayer then return nil, nil end
    local myChar = LocalPlayer.Character 
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart") 
    if not myRoot then return nil, nil end
    
    local nearestPlayer, minDist = nil, math.huge
    local targetVelocity = Vector3.new(0, 0, 0)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead and player.Character.Parent == Workspace then
                if not player.Team or not LocalPlayer.Team or player.Team ~= LocalPlayer.Team then
                    local enemyRoot = player.Character.HumanoidRootPart 
                    local dist = (enemyRoot.Position - myRoot.Position).Magnitude
                    
                    local velocity = enemyRoot.AssemblyLinearVelocity
                    if dist < minDist and dist <= getgenv().aimConfig.MAX_DISTANCE and velocity.Y > -100 then 
                        minDist = dist
                        nearestPlayer = enemyRoot
                        targetVelocity = velocity
                    end
                end
            end
        end
    end 
    
    if nearestPlayer then
        local predictedPos = nearestPlayer.Position + (targetVelocity * getgenv().aimConfig.PREDRATE)
        return nearestPlayer, predictedPos
    end
    return nil, nil
end

-- Re-Queue Function
local function JoinMatchmaking()
    pcall(function()
        local globalMatchmaking = ReplicatedStorage:FindFirstChild("GlobalMatchmaking")
        local remotes = globalMatchmaking and globalMatchmaking:FindFirstChild("Remotes")
        local joinQueue = remotes and remotes:FindFirstChild("JoinQueue")
        
        if joinQueue then
            joinQueue:InvokeServer("Solo")
        end
    end)
end

-- Core Loop Handler
local function StartCombatLoop()
    if autoShootConnection then autoShootConnection:Disconnect() end
    
    autoShootConnection = RunService.Heartbeat:Connect(function()
        local LocalPlayer = Players.LocalPlayer
        if not LocalPlayer or not LocalPlayer.Character then return end

        -- Auto Queue in Lobby
        if getgenv().autoFarm then
            local currentTime = os.clock()
            if (currentTime - lastQueueTime) >= QUEUE_COOLDOWN then
                lastQueueTime = currentTime
                task.spawn(JoinMatchmaking)
            end
        end
        
        -- Auto Equip & Auto Kill in Game
        if getgenv().autoShoot or getgenv().autoFarm then
            if not LocalPlayer.Character:FindFirstChildOfClass("Tool") then
                local currentTime = os.clock()
                if (currentTime - lastEquipTime) >= EQUIP_COOLDOWN then
                    lastEquipTime = currentTime
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Two, false, game)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Two, false, game)
                    end)
                end
            end
            
            local currentTime = os.clock()
            if (currentTime - lastFireTime) < FIRE_RATE_COOLDOWN then return end
            
            local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
            local ShootRemote = remotesFolder and remotesFolder:FindFirstChild("ShootGun")
            if not ShootRemote then return end
            
            local gunModel = LocalPlayer.Character:FindFirstChild("Gun_Equip") or LocalPlayer.Character:FindFirstChildOfClass("Tool")
            local muzzle = gunModel and gunModel:FindFirstChild("Muzzle", true)
            if not muzzle then return end
            
            local targetInstance, predictedPosition = getNearestTarget()
            if targetInstance and predictedPosition then
                lastFireTime = currentTime 
                pcall(function()
                    ShootRemote:FireServer(muzzle.WorldPosition, predictedPosition, targetInstance, predictedPosition)
                end)
            end
        end
    end)
end

