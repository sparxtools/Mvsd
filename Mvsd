-- State Updater
local function SetToggleState(enabled)
    getgenv().autoFarm = enabled
    getgenv().autoShoot = enabled
    
    if enabled then
        StartCombatLoop()
        SaveTeleportState(true)
        
        ToggleButton.BackgroundColor3 = Color3.fromRGB(15, 35, 70)
        BtnStroke.Color = Color3.fromRGB(0, 200, 255)
        
        StatusIndicator.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        Dot.Position = UDim2.new(1, -18, 0.5, 0)
        Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ToggleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        if autoShootConnection then autoShootConnection:Disconnect() end
        SaveTeleportState(false)
        
        ToggleButton.BackgroundColor3 = Color3.fromRGB(15, 18, 35)
        BtnStroke.Color = Color3.fromRGB(50, 80, 140)
        
        StatusIndicator.BackgroundColor3 = Color3.fromRGB(45, 50, 70)
        Dot.Position = UDim2.new(0, 2, 0.5, 0)
        Dot.BackgroundColor3 = Color3.fromRGB(150, 150, 180)
        ToggleLabel.TextColor3 = Color3.fromRGB(200, 220, 255)
    end
end

