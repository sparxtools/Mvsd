-- Sparkles
local function createSparkles(x, y)
    for i = 1, 6 do
        task.spawn(function()
            local Sparkle = Instance.new("Frame")
            Sparkle.Parent = ScreenGui
            Sparkle.BackgroundColor3 = math.random(1, 2) == 1 and Color3.fromRGB(0, 220, 255) or Color3.fromRGB(220, 100, 255)
            Sparkle.BorderSizePixel = 0
            Sparkle.Size = UDim2.new(0, math.random(4, 9), 0, math.random(4, 9))
            Sparkle.Position = UDim2.new(0, x + math.random(-30, 30), 0, y + math.random(-30, 30))
            
            local sparkCorner = Instance.new("UICorner")
            sparkCorner.CornerRadius = UDim.new(1, 0)
            sparkCorner.Parent = Sparkle
            
            local randomAngle = math.rad(math.random(0, 360))
            local distance = math.random(25, 60)
            local targetX = Sparkle.AbsolutePosition.X + math.cos(randomAngle) * distance
            local targetY = Sparkle.AbsolutePosition.Y + math.sin(randomAngle) * distance
            
            local twInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(Sparkle, twInfo, {
                Position = UDim2.new(0, targetX, 0, targetY),
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 1, 0, 1)
            }):Play()
            
            task.wait(0.4)
            Sparkle:Destroy()
        end)
    end
end

